# Pacing times
stim[0].ptcl.stimlist    = "0, 500,    995,   1485,   1970,   2450,   2925,   3395,   3860,   4320, 4775, 5225,   5670,   6110,   6545,   6975,   7400,   7820,   8235,   8645, 9050,   9450,   9845,  10235,  10620,  11000,  11375,  11745,  12110,  12470, 12825,  13175,  13520,  13860,  14195,  14525,  14850,  15170,  15485,  15795, 16100,  16400,  16695,  16985,  17270,  17550,  17825,  18095,  18360,  18620, 18875,  19125,  19370,  19610,  19845,  20075,  20300,  20520,  20735,  20945, 21150,  21350,  21545,  21735,  21920,  22100,  22275,  22445,  22610,  22770, 22925,  23075,  23220,  23360,  23495,  23625,  23750,  23870,  23985,  24095, 24200,  24300,  24395,  24485,  24570,  24650,  24725,  24795,  24860,  24920, 24975,  25025"
