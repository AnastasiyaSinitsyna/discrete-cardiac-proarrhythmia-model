#=======================================================>>
## parameter.par ##
simID                    = mitoxantrone_monolayer_diffuse_fibrosis
meshname                 = monolayer_diffuse_fibrosis

num_external_imp=1
external_imp = /discrete-cardiac-proarrhythmia-model/kernik_2019.so

num_phys_regions         = 1
phys_region[0].ptype     = 0
phys_region[0].num_IDs   = 4
phys_region[0].ID        = 0 1 2 3

dt                       = 50
timedt                   = 0.1
spacedt                  = 10
tend                     = 20000
#sentinel_ID             = 0
experiment               = 0
parab_solve              = 1
mass_lumping             = 0
bidm_eqv_mono            = 0

num_imp_regions          = 3

# Na * 0.713 , Kr - 0.932 , CaL - 0.4115
# Cardiomyocites 0 (in fibrosis)
imp_region[0].im         = kernik_2019
imp_region[0].num_IDs    = 1
imp_region[0].ID         = 0
imp_region[0].im_param   = "g_Na*0.713,g_K1*1.0,g_to*1.0,g_f*0,g_CaT*1.5,g_Kr*0.932,g_Ks*1.0,p_CaL*0.4115"

# Cardiomyocites 1&2 (out fibrosis)
imp_region[1].im         = kernik_2019
imp_region[1].num_IDs    = 2
imp_region[1].ID         = 1 2
imp_region[1].im_param   = "g_Na*0.713,g_K1*1.0,g_to*1.0,g_f*0,g_CaT*1.5,g_Kr*0.932,g_Ks*1.0,p_CaL*0.4115"

# fibrosis
imp_region[2].im         = kernik_2019
imp_region[2].num_IDs    = 1
imp_region[2].ID         = 3
imp_region[2].im_param   = "g_Na*0.0,g_K1*0.1,g_to*0.0,g_f*0,g_CaT*0.0,g_Kr*0.0,g_Ks*0.0,p_CaL*0.0"

num_gregions             = 4
# Cardiomyocites 0 (in fibrosis)
gregion[0].num_IDs       = 1
gregion[0].ID            = 0
gregion[0].g_il          = 0.001855
gregion[0].g_it          = 0.001855
gregion[0].g_in          = 0.001855

# Cardiomyocites 1 (out fibrosis)
gregion[1].num_IDs       = 1
gregion[1].ID            = 1
gregion[1].g_il          = 0.025
gregion[1].g_it          = 0.025
gregion[1].g_in          = 0.025

# Cardiomyocites 2 (out fibrosis)
gregion[2].num_IDs       = 1
gregion[2].ID            = 2
gregion[2].g_il          = 0.0025
gregion[2].g_it          = 0.0025
gregion[2].g_in          = 0.0025

# fibrosis
gregion[3].num_IDs       = 1
gregion[3].ID            = 3
gregion[3].g_il          = 0.0000001
gregion[3].g_it          = 0.0000001 
gregion[3].g_in          = 0.0000001
gregion[3].g_el          = 0.0000001
gregion[3].g_et          = 0.0000001
gregion[3].g_en          = 0.0000001

